---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { withBase } from '../../lib/url';
import { t } from '../../i18n';
---

<BaseLayout title={t('about.title')} description={`About ${SITE.author} and ${SITE.title}.`}>
  <section class="page-head section">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h1>About.</h1>
    <p class="lead">I'm 10deg. I build small tools and write about what I learn along the way.</p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Profile</p>
      <h2>Software, notes, and quiet interfaces.</h2>
    </div>
    <div class="prose-stack">
      <p>
        I'm interested in the parts of software that are easy to overlook: how a tool feels to use,
        how a system ages, and how writing makes both clearer.
      </p>
      <p>
        This site keeps that work in one place — project notes, short experiments, and longer pieces
        on software. It is deliberately small: no feed, no schedule, just things worth keeping.
      </p>
    </div>
  </section>

  <section class="section" aria-label={t('about.ledgerLabel')}>
    <div class="about-ledger">
      <article>
        <span>01</span>
        <h3>Current focus</h3>
        <p>Building small tools, writing more regularly, and keeping this site simple.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Background</h3>
        <p>Software development, with an interest in interfaces, tooling, and documentation.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Contact</h3>
        <p>
          The best way to reach me is on
          <a
            class="text-link"
            href="https://github.com/10deg"
            target="_blank"
            rel="noopener noreferrer">GitHub ↗</a
          >.
        </p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">Elsewhere</p>
      <h2>Find the work.</h2>
    </div>
    <div class="prose-stack">
      <p>
        Browse <a class="text-link" href={withBase('/works/')}>selected projects</a> or read the{
          ' '
        }
        <a class="text-link" href={withBase('/blog/')}>notes</a>.
      </p>
    </div>
  </section>
</BaseLayout>
