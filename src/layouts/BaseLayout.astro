---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { SITE, NAV_ITEMS } from '../consts';
import { locale, navLabel, t } from '../i18n';
import CodeCopy from '../components/CodeCopy.astro';
import NightSky from '../components/NightSky.astro';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

const siteName = SITE.title;

const { title = siteName, description = SITE.description, ogType = 'website', image } = Astro.props;

// `Astro.site` comes from `site` in astro.config.mjs; fall back to the
// request URL during dev so canonical/OG links still resolve.
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBase(SITE.ogImage), siteBase);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? currentPath === full : currentPath.startsWith(full);
};
---

<!doctype html>
<html lang={locale} data-theme="stars">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070f" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('/rss.xml')} />
    <title>{fullTitle}</title>

    {/* Astro comment syntax — an HTML comment here would ship on every page. */}
    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {/* Open Graph wants `ja_JP`, not the `ja-JP` of `<html lang>`. */}
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    {/* Twitter */}
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      // Runs before paint on the initial load, and again on `astro:after-swap`
      // because the router resets `<html>` attributes during soft navigation.
      // IIFE so top-level consts can't clash if the script ever re-runs.
      (() => {
        const applyTheme = () => {
          // Both themes are dark; `rain` is the only alternative to `stars`.
          // Older `light` / `dark` values from the template fall back to stars.
          const stored = localStorage.getItem('theme');
          document.documentElement.dataset.theme = stored === 'rain' ? 'rain' : 'stars';
        };
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <NightSky />
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label={t('nav.brandHome', { site: siteName })}>
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 2c.7 5.4 4.6 9.3 10 10-5.4.7-9.3 4.6-10 10-.7-5.4-4.6-9.3-10-10 5.4-.7 9.3-4.6 10-10Z"
            fill="currentColor"></path>
        </svg>
        <span class="brand-text">
          <span class="brand-name">{siteName}</span>
          <span class="brand-sub">{SITE.subtitle}</span>
        </span>
      </a>
      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          NAV_ITEMS.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {navLabel(item)}
            </a>
          ))
        }
      </nav>
      <button
        class="theme-toggle"
        type="button"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
        data-theme-toggle
        data-label-stars={t('theme.toStars')}
        data-label-rain={t('theme.toRain')}
      >
        <svg
          class="theme-icon theme-icon-stars"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="currentColor"
        >
          <path
            d="M12 2c.7 5.4 4.6 9.3 10 10-5.4.7-9.3 4.6-10 10-.7-5.4-4.6-9.3-10-10 5.4-.7 9.3-4.6 10-10Z"
          ></path>
        </svg>
        <svg
          class="theme-icon theme-icon-rain"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7.5 15.5h9a3.5 3.5 0 0 0 .4-6.98A5 5 0 0 0 7.3 8.6 3.5 3.5 0 0 0 7.5 15.5Z"
          ></path>
          <path d="M8.5 18.5 7.5 21M12.5 18.5 11.5 21M16.5 18.5 15.5 21"></path>
        </svg>
      </button>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{SITE.footerText}</p>
      <div class="footer-links">
        <a href={withBase('/blog/')}>{t('footer.notes')}</a>
        <a href="https://github.com/10deg/moonless" target="_blank" rel="noopener noreferrer">
          Source ↗
        </a>
      </div>
      <SocialLinks />
    </footer>

    <CodeCopy />

    <script>
      const THEME_KEY = 'theme';

      const currentTheme = () =>
        document.documentElement.dataset.theme === 'rain' ? 'rain' : 'stars';

      const syncToggle = () => {
        const theme = currentTheme();
        const button = document.querySelector('[data-theme-toggle]');
        if (button instanceof HTMLButtonElement) {
          // The label describes what clicking will do next.
          const label = theme === 'rain' ? button.dataset.labelStars : button.dataset.labelRain;
          if (label) {
            button.setAttribute('aria-label', label);
            button.setAttribute('title', label);
          }
        }
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'rain' ? '#0b0906' : '#05070f');
      };

      const setTheme = (nextTheme: string) => {
        const next = nextTheme === 'rain' ? 'rain' : 'stars';
        document.documentElement.dataset.theme = next;
        localStorage.setItem(THEME_KEY, next);
        syncToggle();
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
      };

      // Delegated to `document` so the handler survives view-transition swaps
      // that replace the toggle button element.
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) {
          return;
        }
        setTheme(currentTheme() === 'rain' ? 'stars' : 'rain');
      });

      document.addEventListener('astro:page-load', syncToggle);
      document.addEventListener('astro:after-swap', syncToggle);
      syncToggle();
    </script>
  </body>
</html>
